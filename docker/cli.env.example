# Pre-fills the CLI's prompts for `pnpm docker:cli`: MySQL lab -> PostgreSQL lab.
# Generated by `pnpm docker:init` with the lab passwords. Hostnames are Compose
# service names, because the CLI runs inside the movy-net network. Swap the
# blocks for any other Pair (pattern: {SOURCE|TARGET}_{ENGINE}_{FIELD}).
#
# The target is its own database, created by step 1 of the run, so the CLI never
# writes into the movy_dst the e2e suite migrates into.

SOURCE_MYSQL_HOSTNAME=mysql-lab
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_USERNAME=root
SOURCE_MYSQL_PASSWORD=
SOURCE_MYSQL_DATABASE=movy_src

TARGET_POSTGRES_HOSTNAME=pg-lab
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_USERNAME=postgres
TARGET_POSTGRES_PASSWORD=
TARGET_POSTGRES_DATABASE=movy_cli
