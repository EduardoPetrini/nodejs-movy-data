# Passwords for the throwaway lab databases (pg-lab, mysql-lab, mssql-lab).
# Generated by `pnpm docker:init`. Each key is the name its image reads, and
# seed-lab.ts reads the same keys to save the matching connections.

POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=
# SQL Server refuses a weak SA password: 8+ chars, three of upper, lower,
# digit and symbol.
MSSQL_SA_PASSWORD=
