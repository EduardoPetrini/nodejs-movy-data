# The web app's environment inside Compose. Generated by `pnpm docker:init`
# (scripts/docker-init.sh), which fills every secret below. Not the root .env:
# that one belongs to the CLI and is never read by Compose.

# Movy's own metadata database (the `meta-db` service), NOT one being migrated.
# The password must equal POSTGRES_PASSWORD in docker/meta-db.env.
NUXT_DATABASE_URL=postgres://movy:CHANGE_ME@meta-db:5432/movy_data

# 32 random bytes, base64. Encrypts saved connection passwords at rest.
NUXT_ENCRYPTION_KEY=

# Seals the session cookie. Rotating it signs everyone out.
NUXT_SESSION_PASSWORD=

# Local stack only: the dev seed signs in with passwords. Never 'true' in a
# deployment anyone else can reach.
NUXT_ALLOW_PASSWORD_LOGIN=true

# Google SSO (optional)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_ALLOWED_EMAIL_DOMAIN=
