# The runner services' environment inside Compose. Generated by `pnpm docker:init`.
# Deliberately NOT docker/movy.env: a runner gets the least-privilege movy_runner
# role and the encryption key, never the meta-db owner's password or the session
# secret.

# The movy_runner role's password. The `migrate` service creates the role (or
# resets its password) from this on every `docker compose up`.
RUNNER_DB_PASSWORD=

# The metadata database as movy_runner: the queue, run events and progress, the
# runners table. No access to connections, users or organizations.
MOVY_DATABASE_URL=postgres://movy_runner:CHANGE_ME@meta-db:5432/movy_data

# Must equal NUXT_ENCRYPTION_KEY in docker/movy.env: every run spec is sealed
# with it, and a runner with another key fails each run it claims.
MOVY_ENCRYPTION_KEY=
