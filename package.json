{
  "name": "nodejs-movy-data",
  "version": "1.0.0",
  "private": true,
  "description": "Database-agnostic migration tool. Migrates schema and data between PostgreSQL, MySQL and MSSQL.",
  "scripts": {
    "start": "pnpm --filter @movy/cli start",
    "dev": "pnpm --filter @movy/cli dev",
    "dev:web": "pnpm --filter @movy/web dev",
    "build": "tsc -b packages/core apps/cli apps/runner && pnpm --filter @movy/web build",
    "typecheck": "pnpm --filter @movy/core typecheck && pnpm --filter @movy/cli typecheck && pnpm --filter @movy/runner typecheck && pnpm --filter @movy/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "pnpm --filter @movy/web db:migrate",
    "db:generate": "pnpm --filter @movy/web db:generate",
    "seed:dev": "pnpm --filter @movy/web exec tsx --env-file=.env scripts/seed-dev.ts",
    "simulate": "tsx --tsconfig apps/runner/tsconfig.dev.json apps/runner/src/main.ts",
    "test:e2e": "pnpm --filter @movy/web test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
