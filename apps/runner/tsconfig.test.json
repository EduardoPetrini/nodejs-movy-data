{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // A composite project may not disable declaration emit, and this config
    // exists only to type-check tests — it never produces output.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "./"
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
