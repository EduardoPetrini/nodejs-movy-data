{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // A composite project may not disable declaration emit, and this config
    // exists only to type-check tests — it never produces output.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // The repo root, not ./: the queue tests share packages/db's PGlite
    // harness, so the real migrations are what they run against.
    "rootDir": "../../"
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
