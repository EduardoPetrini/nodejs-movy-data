{
  "name": "@movy/web",
  "version": "1.0.0",
  "private": true,
  "description": "Movy web UI: org-scoped console for running and reviewing migrations.",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && tsc --noEmit -p .nuxt/tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@movy/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pg": "^8.20.0",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
