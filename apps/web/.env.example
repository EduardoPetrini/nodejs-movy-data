# Dev server port. Defaults to 3000 when unset.
NUXT_PORT=3000

# Movy's own metadata database (NOT a database being migrated)
NUXT_DATABASE_URL=postgres://postgres:password@localhost:5432/movy_data

# 32 random bytes, base64. Encrypts saved connection passwords at rest.
#   openssl rand -base64 32
NUXT_ENCRYPTION_KEY=

# Seals the session cookie. Rotating it signs everyone out.
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Google SSO
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Optional: restrict Google sign-in to one email domain
NUXT_ALLOWED_EMAIL_DOMAIN=

# Dev only. The credentials endpoint returns 404 unless this is exactly 'true'.
NUXT_ALLOW_PASSWORD_LOGIN=false
