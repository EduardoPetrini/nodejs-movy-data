# Dev server port. Defaults to 3000 when unset.
NUXT_PORT=3000

# Movy's own metadata database (NOT a database being migrated)
NUXT_DATABASE_URL=postgres://postgres:password@localhost:5432/movy_data

# 32 random bytes, base64. Encrypts saved connection passwords at rest.
#   openssl rand -base64 32
NUXT_ENCRYPTION_KEY=

# Seals the session cookie. Rotating it signs everyone out.
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Google SSO
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Optional: restrict Google sign-in to one email domain
NUXT_ALLOWED_EMAIL_DOMAIN=

# Dev only. The credentials endpoint returns 404 unless this is exactly 'true'.
NUXT_ALLOW_PASSWORD_LOGIN=false

# Runner location overrides. Unset in a dev checkout, where the defaults resolve
# relative to apps/web. docker-compose.yml sets all three, because a built image
# has no ../runner beside it.
# MOVY_RUNNER_ENTRY=/app/apps/runner/dist/main.js
# MOVY_SIMULATION_FIXTURE=/app/apps/runner/fixtures/pg-to-pg-315k.ndjson
# MOVY_JOURNAL_DIR=/data/runs

# Runner agent (docs/runner-service-plan.md). The web process runs one embedded
# agent unless this is 'false'; until the runner services of phase 6 exist,
# turning it off leaves every run queued.
# MOVY_EMBEDDED_RUNNER=true
# MOVY_RUNNER_SLOTS=4             # runs this host executes at once
# MOVY_RUNNER_CLASS=default
# MOVY_RUNNER_ID=                 # default embedded-<hostname>; must be stable across restarts
# MOVY_RUNNER_SWEEPER=true        # settles runs whose runner stopped heartbeating
# MOVY_RUNNER_CLASSES_FILE=../../docker/runner-classes.json   # runner classes, upserted at boot
