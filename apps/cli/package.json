{
  "name": "@movy/cli",
  "version": "1.0.0",
  "private": true,
  "description": "Movy interactive command-line delivery surface.",
  "main": "dist/main.js",
  "bin": {
    "movy": "dist/main.js"
  },
  "scripts": {
    "start": "tsx --tsconfig tsconfig.dev.json src/main.ts",
    "dev": "tsx watch --tsconfig tsconfig.dev.json src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@movy/core": "workspace:*"
  }
}
